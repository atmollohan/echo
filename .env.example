# Echo Protocol — Environment Variables
# Copy to .env and fill in your values. Never commit .env files.

# --- Local development ---
# STREAMLIT_SERVER_PORT=8501
# STREAMLIT_SERVER_HEADLESS=true

# --- Data directories (mounts override these) ---
# ECHO_NOTEBOOKS_DIR=/app/notebooks
# ECHO_DATA_DIR=/app/data

# --- Cloudflare Tunnel (for Pi deployment) ---
# CLOUDFLARE_TUNNEL_TOKEN=
